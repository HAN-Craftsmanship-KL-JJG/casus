@startuml request-sequence
' Sequence diagram van een verzoek: het voorbeelddocument als PDF. Toelichting: README.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica

actor Gebruiker as user
participant "Browser\nReact" as browser
participant "Webserver\nweb/" as web
participant "Applicatieserver\napi/" as api
database "Database\ndb/" as db
participant "Documentserver\ndocumentserver/" as docs

user -> browser : klik op "Voorbeeld als PDF"
browser -> web : GET /api/example/pdf
web -> api : geeft door, vanwege /api
api -> db : SELECT message FROM example
db --> api : bericht
api -> docs : POST /convert/pdf, met Markdown
docs --> api : PDF
api --> browser : PDF
browser --> user : toont de PDF
@enduml
