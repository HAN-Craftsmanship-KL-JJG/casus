@startuml domeinmodel
' Domeinmodel van ICDE. Toelichting: docs/domeinmodel.md
' Een domeinmodel heeft geen operaties, datatypes, visibility of navigatie.
hide circle
hide methods
hide empty members
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0

class Opleiding {
  naam
}
class Profiel {
  naam
}
class OWE {
  code
  naam
  studiepunten
  aantalWeken
}
class EVL {
  naam
  studiepunten
}
abstract class "OWE-onderdeel" as Onderdeel
class Leeruitkomst {
  nummer
  omschrijving
}
class Beoordelingsdimensie {
  naam
}
class Beoordelingscriterium {
  code
  naam
  weging
  minimumscore
  uitleg
}
class Niveau {
  score
  beschrijving
}
class Les {
  naam
  onderwijsweek
  beschrijving
}
class Toetsmoment {
  naam
  soort
  startweek
  deadlineweek
}
class Documentsjabloon {
  naam
  soortDocument
  onderdelen
  volgorde
  opmaak
}

Opleiding "1" -- "0..*" Profiel : heeft >
Opleiding "1" -- "0..*" OWE : biedt aan >
Profiel "0..*" -- "0..*" OWE : omvat >
OWE "1" -- "1..*" EVL : bestaat uit >
EVL "1" -- "0..*" Leeruitkomst : groepeert >
OWE "1" -- "0..*" Beoordelingsdimensie : beoordeelt met >
Beoordelingsdimensie "1" -- "1..*" Beoordelingscriterium : bestaat uit >
Beoordelingscriterium "1" -- "1..*" Niveau : onderscheidt >
OWE "1" -- "0..*" Les : plant >
OWE "1" -- "0..*" Toetsmoment : plant >

Beoordelingscriterium "0..*" -- "1..*" Leeruitkomst : toetst >
Les "0..*" -- "0..*" Beoordelingscriterium : draagt bij aan >
Toetsmoment "0..*" -- "0..*" Beoordelingscriterium : beoordeelt >

Onderdeel <|-- Leeruitkomst
Onderdeel <|-- Beoordelingsdimensie
Onderdeel <|-- Les
Onderdeel <|-- Toetsmoment
Onderdeel "0..*" -- "0..*" Profiel : gedeeld met >
OWE "0..*" -- "0..*" Onderdeel : hergebruikt >
@enduml
