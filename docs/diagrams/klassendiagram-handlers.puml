@startuml klassendiagram-handlers
' Design class diagram van ICDE: use case controllers en repositories.
' Toelichting: docs/klassendiagram.md
' De domeinklassen staan volledig in klassendiagram-domein.puml.
' Verwijzingen naar repositories staan als attribuut, niet als lijn (Larman 7.4).
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package applicatie {
  class BeheerOWEHandler {
    - opleidingen : OpleidingRepository
    - owes : OWERepository
    + maakOWE(opleidingNaam : String, code : String,\n    \
naam : String, studiepunten : int,\n    \
aantalWeken : int, evlNaam : String,\n    \
evlStudiepunten : int) : void
    + toevoegenEVL(oweCode : String, naam : String,\n    \
studiepunten : int) : void
    + toevoegenLeeruitkomst(oweCode : String,\n    \
evlNaam : String, nummer : int,\n    \
omschrijving : String) : void
    + verwijderOnderdeel(oweCode : String,\n    \
onderdeelId : UUID) : void
    + verwijderEVL(oweCode : String, evlNaam : String) : void
    + verwijderOWE(oweCode : String) : void
  }
  class BeheerRubricHandler {
    - owes : OWERepository
    + toevoegenDimensie(oweCode : String, naam : String,\n    \
criteriumCode : String, criteriumNaam : String,\n    \
weging : int, minimumscore : int, uitleg : String,\n    \
niveaus : Map<Integer, String>,\n    \
leeruitkomstNummers : List<Integer>) : void
    + toevoegenCriterium(oweCode : String,\n    \
dimensieNaam : String, code : String, naam : String,\n    \
weging : int, minimumscore : int, uitleg : String,\n    \
niveaus : Map<Integer, String>,\n    \
leeruitkomstNummers : List<Integer>) : void
    + verwijderCriterium(oweCode : String,\n    \
dimensieNaam : String, code : String) : void
  }
  class BeheerPlanningHandler {
    - owes : OWERepository
    + toevoegenLes(oweCode : String, naam : String,\n    \
onderwijsweek : int, beschrijving : String,\n    \
criteriumCodes : List<String>) : List<Overtreding>
    + toevoegenToetsmoment(oweCode : String, naam : String,\n    \
soort : SoortToetsmoment, startweek : int,\n    \
deadlineweek : int,\n    \
criteriumCodes : List<String>) : List<Overtreding>
  }
  class ControleerConsistentieHandler {
    - owes : OWERepository
    + controleer(oweCode : String) : List<Overtreding>
  }
  class GenereerDocumentHandler {
    - owes : OWERepository
    - sjablonen : DocumentsjabloonRepository
    + geefSjablonen() : List<Documentsjabloon>
    + genereer(oweCode : String, sjabloonNaam : String,\n    \
onderdelen : List<String>,\n    \
bestandstype : Bestandstype) : byte[]
  }
  class HergebruikOnderdeelHandler {
    - owes : OWERepository
    + geefGedeeldeOnderdelen(oweCode : String) : List<OWEOnderdeel>
    + opnemenOnderdeel(oweCode : String, onderdeelId : UUID) : void
    + opnemenKopie(oweCode : String, onderdeelId : UUID) : void
  }
  class OpvragenDekkingHandler {
    - opleidingen : OpleidingRepository
    - owes : OWERepository
    + geefDekking(opleidingNaam : String) : List<Dekking>
  }
  class DeelOnderdeelHandler {
    - owes : OWERepository
    + deel(oweCode : String, onderdeelId : UUID) : void
  }
  class BeheerDocumentsjabloonHandler {
    - sjablonen : DocumentsjabloonRepository
    + toevoegenSjabloon(naam : String, soort : SoortDocument,\n    \
onderdelen : List<String>, opmaak : String) : void
  }
  class VergrendelVeldHandler {
    - vergrendelingen : VergrendelingRepository
    + vergrendel(oweCode : String, onderdeelId : UUID,\n    \
veld : String) : boolean
    + ontgrendel(oweCode : String, onderdeelId : UUID,\n    \
veld : String) : void
  }
}

package domein {
  interface OWERepository <<interface>> {
    + zoek(code : String) : OWE
    + zoekGedeeldeOnderdelen() : List<OWEOnderdeel>
    + zoekGedeeldOnderdeel(onderdeelId : UUID) : OWEOnderdeel
    + wordtHergebruikt(onderdeelId : UUID) : boolean
    + bewaar(owe : OWE) : void
    + verwijder(owe : OWE) : void
  }
  interface OpleidingRepository <<interface>> {
    + zoek(naam : String) : Opleiding
  }
  interface DocumentsjabloonRepository <<interface>> {
    + zoek(naam : String) : Documentsjabloon
    + zoekAlle() : List<Documentsjabloon>
    + bewaar(sjabloon : Documentsjabloon) : void
  }
  interface VergrendelingRepository <<interface>> {
    + zoek(oweCode : String, onderdeelId : UUID,\n    \
veld : String) : Vergrendeling
    + bewaar(vergrendeling : Vergrendeling) : void
    + verwijder(vergrendeling : Vergrendeling) : void
  }
  class Vergrendeling {
    - oweCode : String
    - onderdeelId : UUID
    - veld : String
    - gebruiker : String
    - sinds : Instant
  }
  interface Consistentieregel <<interface>>
}

BeheerPlanningHandler --> "2 regels" Consistentieregel
ControleerConsistentieHandler --> "1..* regels" Consistentieregel
' Onzichtbare lijnen zetten elke handler naast zijn repositories.
BeheerOWEHandler -[hidden]-> OpleidingRepository
BeheerOWEHandler -[hidden]-> OWERepository
BeheerRubricHandler -[hidden]-> OWERepository
BeheerPlanningHandler -[hidden]-> OWERepository
ControleerConsistentieHandler -[hidden]-> OWERepository
GenereerDocumentHandler -[hidden]-> OWERepository
GenereerDocumentHandler -[hidden]-> DocumentsjabloonRepository
HergebruikOnderdeelHandler -[hidden]-> OWERepository
OpvragenDekkingHandler -[hidden]-> OpleidingRepository
OpvragenDekkingHandler -[hidden]-> OWERepository
DeelOnderdeelHandler -[hidden]-> OWERepository
BeheerDocumentsjabloonHandler -[hidden]-> DocumentsjabloonRepository
VergrendelVeldHandler -[hidden]-> VergrendelingRepository
VergrendelingRepository ..> Vergrendeling
@enduml
