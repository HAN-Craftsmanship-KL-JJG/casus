@startuml ci-overview
' Which event starts which automation. Explanation: docs/deployment.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
left to right direction

rectangle "Pull request" as pr
rectangle "Push to develop" as develop
rectangle "Push to main" as main
rectangle "Tag vX.Y.Z" as tag
rectangle "Each week" as week

rectangle "Workflow Ontwerpdocument" as doc
rectangle "Workflow Deploy" as deploy
rectangle "Dependabot" as bot

rectangle "PDF as workflow artifact" as artifact
rectangle "Release with the PDF" as release
rectangle "dev.icde.nl" as dev
rectangle "icde.nl" as prd

pr --> doc
main --> doc
tag --> doc
develop --> deploy
main --> deploy
week --> bot

doc --> artifact
doc --> release : main or tag
deploy --> dev : develop
deploy --> prd : main
bot --> pr : opens
@enduml
