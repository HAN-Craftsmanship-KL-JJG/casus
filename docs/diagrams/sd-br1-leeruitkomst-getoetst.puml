@startuml sd-br1-leeruitkomst-getoetst
' Sequence diagram van LeeruitkomstGetoetstRegel.controleer (BR1).
' Toelichting: docs/08-sequencediagrammen.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
hide footbox

participant ":LeeruitkomstGetoetst\nRegel" as regel
participant "owe : OWE" as owe
participant "rubric : Rubric" as rubric
participant "criteria[j] :\nBeoordelingscriterium" as criterium
participant "o : Overtreding" as overtreding

[-> regel : overtredingen = controleer(owe)
activate regel
regel -> owe : leeruitkomsten = geefLeeruitkomsten()
activate owe
deactivate owe
regel -> owe : rubric = geefRubric()
activate owe
deactivate owe
regel -> rubric : criteria = geefCriteria()
activate rubric
deactivate rubric
loop voor elke l in leeruitkomsten
  loop voor elk criterium, tot getoetst
    regel -> criterium : getoetst = toetst(l)
    activate criterium
    deactivate criterium
  end
  opt niet getoetst
    create overtreding
    regel -> overtreding : create("BR1", melding, [l])
  end
end
[<-- regel : overtredingen
deactivate regel
@enduml
