@startuml klassendiagram-domein
' Design class diagram van ICDE: de domeinklassen. Toelichting: docs/07-klassendiagram.md
' Getters en setters staan er niet in, zoals bij Larman (7.6).
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
hide empty members

class Opleiding {
  - naam : String
  + maakOWE(code : String, naam : String,\n    \
studiepunten : int, aantalWeken : int,\n    \
evlNaam : String, evlStudiepunten : int) : OWE
  + bepaalDekking() : List<Dekking>
}

class OWE {
  - code : String
  - naam : String
  - studiepunten : int
  + toevoegenEVL(naam : String, studiepunten : int) : EVL
  + verwijderEVL(naam : String) : void
  + toevoegenLeeruitkomst(evlNaam : String, nummer : int,\n    \
omschrijving : String) : Leeruitkomst
  + hergebruik(leeruitkomst : Leeruitkomst) : void
  + verwijder(onderdeel : OWEOnderdeel) : void
  + bevat(onderdeel : OWEOnderdeel) : boolean
  + zoekOnderdeel(id : UUID) : OWEOnderdeel
  + zoekLeeruitkomsten(nummers : List<Integer>) : List<Leeruitkomst>
  + geefLeeruitkomsten() : List<Leeruitkomst>
  + bepaalDekking() : List<Dekking>
}

class Rubric {
  + toevoegenDimensie(naam : String,\n    \
criteriumCode : String, criteriumNaam : String,\n    \
weging : int, minimumscore : int, uitleg : String,\n    \
niveaus : Map<Integer, String>,\n    \
leeruitkomsten : List<Leeruitkomst>) : Beoordelingsdimensie
  + hergebruik(dimensie : Beoordelingsdimensie) : void
  + zoekDimensie(naam : String) : Beoordelingsdimensie
  + zoekCriteria(codes : List<String>) : List<Beoordelingscriterium>
  + geefCriteria() : List<Beoordelingscriterium>
}

class Planning {
  - aantalWeken : int
  + toevoegenLes(naam : String, onderwijsweek : int,\n    \
beschrijving : String,\n    \
criteria : List<Beoordelingscriterium>) : Les
  + toevoegenToetsmoment(naam : String,\n    \
soort : SoortToetsmoment, startweek : int,\n    \
deadlineweek : int,\n    \
criteria : List<Beoordelingscriterium>) : Toetsmoment
  + hergebruik(les : Les) : void
  + hergebruik(toetsmoment : Toetsmoment) : void
  + geefLessen() : List<Les>
  + geefToetsmomenten() : List<Toetsmoment>
  - controleerWeek(week : int) : void
}

class EVL {
  - naam : String
  - studiepunten : int
  + toevoegenLeeruitkomst(nummer : int,\n    \
omschrijving : String) : Leeruitkomst
}

abstract class OWEOnderdeel {
  - id : UUID
  - gedeeld : boolean
  + deel() : void
  + {abstract} hergebruikIn(owe : OWE) : void
}

class Leeruitkomst {
  - nummer : int
  - omschrijving : String
  + hergebruikIn(owe : OWE) : void
}

class Beoordelingsdimensie {
  - naam : String
  + hergebruikIn(owe : OWE) : void
  + toevoegenCriterium(code : String, naam : String,\n    \
weging : int, minimumscore : int, uitleg : String,\n    \
niveaus : Map<Integer, String>,\n    \
leeruitkomsten : List<Leeruitkomst>) : Beoordelingscriterium
  + verwijderCriterium(code : String) : void
}

class Beoordelingscriterium {
  - code : String
  - naam : String
  - weging : int
  - minimumscore : int
  - uitleg : String
  + toetst(leeruitkomst : Leeruitkomst) : boolean
}

class Niveau {
  - score : int
  - beschrijving : String
}

class Les {
  - naam : String
  - onderwijsweek : int
  - beschrijving : String
  + kopieerNaar(planning : Planning) : OWEOnderdeel
  + hergebruikIn(owe : OWE) : void
  + heeftCriteria() : boolean
  + dekt(criterium : Beoordelingscriterium) : boolean
}

class Toetsmoment {
  - naam : String
  - soort : SoortToetsmoment
  - startweek : int
  - deadlineweek : int
  + kopieerNaar(planning : Planning) : OWEOnderdeel
  + hergebruikIn(owe : OWE) : void
  + beoordeelt(criterium : Beoordelingscriterium) : boolean
  + omvat(week : int) : boolean
}

class Documentsjabloon {
  - naam : String
  - soortDocument : SoortDocument
  - onderdelen : List<String>
  - opmaak : String
  + zoekOntbrekendeGegevens(owe : OWE,\n    \
onderdelen : List<String>) : List<String>
  + genereer(owe : OWE, onderdelen : List<String>,\n    \
bestandstype : Bestandstype) : byte[]
}

interface Kopieerbaar <<interface>> {
  + kopieerNaar(planning : Planning) : OWEOnderdeel
}

enum SoortToetsmoment <<enumeration>> {
  TOETS
  OPDRACHT
}

enum SoortDocument <<enumeration>> {
  OWE_BESCHRIJVING
  EVL_BESCHRIJVING
  TOETSPLANNING
  BEOORDELINGSFORMULIER
}

enum Bestandstype <<enumeration>> {
  PDF
  WORD
}

' Langere lijnen geven de rolnamen van hergebruik ruimte.
Opleiding --> "0..* owes" OWE
OWE --> "1..* evls" EVL
OWE --> "1 rubric" Rubric
OWE --> "1 planning" Planning
OWE --> "0..* hergebruikt" Leeruitkomst
EVL --> "0..* leeruitkomsten" Leeruitkomst
Rubric --> "0..* dimensies" Beoordelingsdimensie
Rubric ---> "0..* hergebruikt" Beoordelingsdimensie
Beoordelingsdimensie --> "1..* criteria" Beoordelingscriterium
Beoordelingscriterium --> "1..* niveaus" Niveau
Beoordelingscriterium --> "1..* leeruitkomsten" Leeruitkomst
Planning --> "0..* lessen" Les
Planning --> "0..* toetsmomenten" Toetsmoment
Planning ---> "0..* hergebruikteLessen" Les
Planning ---> "0..* hergebruikteToetsmomenten" Toetsmoment
Les --> "0..* criteria" Beoordelingscriterium
Toetsmoment --> "0..* criteria" Beoordelingscriterium

OWEOnderdeel <|-- Leeruitkomst
OWEOnderdeel <|-- Beoordelingsdimensie
OWEOnderdeel <|-- Les
OWEOnderdeel <|-- Toetsmoment
Kopieerbaar <|.. Les
Kopieerbaar <|.. Toetsmoment

Documentsjabloon ..> OWE
@enduml
