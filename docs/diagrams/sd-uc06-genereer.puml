@startuml sd-uc06-genereer
' Sequence diagram van systeemoperatie genereer (UC06, stap 3 tot en met 5).
' Toelichting: docs/08-sequencediagrammen.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
hide footbox

actor ":Onderwijsontwikkelaar" as ontwikkelaar
participant ":GenereerDocument\nHandler" as handler
participant "owes :\nOWERepository" as owes
participant "sjablonen :\nDocumentsjabloon\nRepository" as sjablonen
participant "sjabloon :\nDocumentsjabloon" as sjabloon
participant "owe : OWE" as owe
participant "omzetter :\nDocumentomzetter" as omzetter

ontwikkelaar -> handler : document = genereer(oweCode,\nsjabloonNaam, onderdelen,\nbestandstype)
activate handler
handler -> owes : owe = zoek(oweCode)
activate owes
deactivate owes
handler -> sjablonen : sjabloon = zoek(sjabloonNaam)
activate sjablonen
deactivate sjablonen
handler -> sjabloon : ontbrekend =\nzoekOntbrekendeGegevens(owe, onderdelen)
activate sjabloon
sjabloon -> owe : geef-operaties en getters
activate owe
deactivate owe
deactivate sjabloon
alt ontbrekend is niet leeg
  handler --> ontwikkelaar : OngeldigeInvoerException\n(ontbrekend) (4A)
else
  handler -> sjabloon : inhoud = maakInhoud(owe,\nonderdelen)
  activate sjabloon
  sjabloon -> owe : geef-operaties en getters
  activate owe
  deactivate owe
  deactivate sjabloon
  handler -> sjabloon : opmaak = getOpmaak()
  activate sjabloon
  deactivate sjabloon
  handler -> omzetter : document = zetOm(inhoud,\nopmaak, bestandstype)
  activate omzetter
  deactivate omzetter
  handler --> ontwikkelaar : document
end
deactivate handler
note over sjabloon, owe
  Een lege lijst onderdelen betekent:
  alle onderdelen van het sjabloon (3A).
  Het sjabloon leest alleen de gegevens
  van die onderdelen.
  De documentserver past de opmaak
  toe, achter Documentomzetter (A2).
end note
@enduml
