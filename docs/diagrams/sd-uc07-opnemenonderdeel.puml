@startuml sd-uc07-opnemenonderdeel
' Sequence diagram van systeemoperatie opnemenOnderdeel (UC07, stap 3 en 4).
' Toelichting: docs/08-sequencediagrammen.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
hide footbox

actor ":Onderwijsontwikkelaar" as ontwikkelaar
participant ":HergebruikOnderdeel\nHandler" as handler
participant "owes :\nOWERepository" as owes
participant "owe : OWE" as owe
participant "onderdeel :\nOWEOnderdeel" as onderdeel
participant "planning :\nPlanning" as planning

ontwikkelaar -> handler : opnemenOnderdeel(oweCode, onderdeelId)
activate handler
handler -> owes : owe = zoek(oweCode)
activate owes
deactivate owes
handler -> owes : onderdeel =\nzoekGedeeldOnderdeel(onderdeelId)
activate owes
deactivate owes
alt onderdeel is null
  handler --> ontwikkelaar : OngeldigeInvoerException (4A)
else
  handler -> onderdeel : hergebruikIn(owe)
  activate onderdeel
  note right of onderdeel
    Polymorfe message.
    Hier een Les. Een Toetsmoment gaat ook
    naar Planning, een Beoordelingsdimensie
    naar Rubric, een Leeruitkomst naar OWE.
  end note
  onderdeel -> owe : planning = geefPlanning()
  activate owe
  deactivate owe
  onderdeel -> planning : hergebruik(onderdeel)
  activate planning
  planning -> planning : hergebruikteLessen.add(onderdeel)
  deactivate planning
  deactivate onderdeel
  handler -> owes : bewaar(owe)
  activate owes
  deactivate owes
end
deactivate handler
note over planning
  planning bewaart een verwijzing,
  geen kopie [BR6].
end note
@enduml
