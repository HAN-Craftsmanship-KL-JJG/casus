@startuml sd-uc07-neemop
' Sequence diagram van systeemoperatie neemOp (UC07, stap 5 en 6).
' Toelichting: docs/sequencediagrammen.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
hide footbox

actor ":Onderwijsontwikkelaar" as ontwikkelaar
participant ":HergebruikOnderdeel\nHandler" as handler
participant "owes :\nOWERepository" as owes
participant "herkomst : OWE" as herkomst
participant "owe : OWE" as owe
participant "onderdeel :\nOWEOnderdeel" as onderdeel

ontwikkelaar -> handler : neemOp(oweCode, herkomstCode, onderdeelId)
activate handler
handler -> owes : owe = zoek(oweCode)
activate owes
deactivate owes
handler -> owes : herkomst = zoek(herkomstCode)
activate owes
deactivate owes
handler -> herkomst : onderdeel = zoekOnderdeel(onderdeelId)
activate herkomst
deactivate herkomst
handler -> owe : hergebruik(onderdeel)
activate owe
owe -> onderdeel : gedeeld = isGedeeld()
activate onderdeel
deactivate onderdeel
alt niet gedeeld, of owe bevat het onderdeel al
  owe --> handler : OngeldigeInvoerException
  deactivate owe
  handler --> ontwikkelaar : OngeldigeInvoerException (6A)
else
  activate owe
  owe -> owe : hergebruikt.add(onderdeel)
  deactivate owe
  handler -> owes : bewaar(owe)
  activate owes
  deactivate owes
end
deactivate handler
note over owe, onderdeel
  owe bewaart een verwijzing, geen kopie [BR6].
end note
@enduml
