@startuml sd-uc07-opnemenkopie
' Sequence diagram van systeemoperatie opnemenKopie (UC07, flow 3A).
' Toelichting: docs/08-sequencediagrammen.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
hide footbox

actor ":Onderwijsontwikkelaar" as ontwikkelaar
participant ":HergebruikOnderdeel\nHandler" as handler
participant "owes :\nOWERepository" as owes
participant "onderdeel :\nKopieerbaar" as onderdeel
participant "owe : OWE" as owe

ontwikkelaar -> handler : opnemenKopie(oweCode, onderdeelId)
activate handler
handler -> owes : owe = zoek(oweCode)
activate owes
deactivate owes
handler -> owes : onderdeel =\nzoekGedeeldOnderdeel(onderdeelId)
activate owes
deactivate owes
alt onderdeel is null
  handler --> ontwikkelaar : OngeldigeInvoerException (4A)
else onderdeel is geen Kopieerbaar
  handler --> ontwikkelaar : OngeldigeInvoerException
else
  handler -> onderdeel : kopie = kopieerNaar(owe)
  activate onderdeel
  note right of onderdeel
    Polymorfe message.
    Hier een Les. Een Toetsmoment
    roept toevoegenToetsmoment aan.
  end note
  onderdeel -> owe : kopie = toevoegenLes(naam,\nonderwijsweek, beschrijving, [])
  activate owe
  owe -> owe : controleerWeek(onderwijsweek)
  deactivate owe
  deactivate onderdeel
  handler -> owes : bewaar(owe)
  activate owes
  deactivate owes
end
deactivate handler
note over onderdeel, owe
  De kopie heeft geen criteria:
  die horen bij de andere OWE [BR11, BR14].
  Ligt de week buiten de looptijd, dan gooit
  controleerWeek een OngeldigeInvoerException (3A2A).
end note
@enduml
