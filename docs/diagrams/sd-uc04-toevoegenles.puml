@startuml sd-uc04-toevoegenles
' Sequence diagram van systeemoperatie toevoegenLes (UC04, Toevoegen les, stap 3 tot en met 6).
' Toelichting: docs/08-sequencediagrammen.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica
hide footbox

actor ":Onderwijsontwikkelaar" as ontwikkelaar
participant ":BeheerPlanning\nHandler" as handler
participant "owes :\nOWERepository" as owes
participant "owe : OWE" as owe
participant "rubric : Rubric" as rubric
participant "planning :\nPlanning" as planning
participant "les : Les" as les
participant "lesRegel :\nConsistentieregel" as regel
participant "alle[i] :\nOvertreding" as overtreding

ontwikkelaar -> handler : overtredingen =\ntoevoegenLes(oweCode, naam,\n\
onderwijsweek, beschrijving,\ncriteriumCodes)
activate handler
handler -> owes : owe = zoek(oweCode)
activate owes
deactivate owes
handler -> owe : rubric = geefRubric()
activate owe
deactivate owe
handler -> owe : planning = geefPlanning()
activate owe
deactivate owe
handler -> rubric : criteria = zoekCriteria(criteriumCodes)
activate rubric
deactivate rubric
handler -> planning : les = toevoegenLes(naam, onderwijsweek,\nbeschrijving, criteria)
activate planning
planning -> planning : controleerWeek(onderwijsweek)
create les
planning -> les : create(naam, onderwijsweek,\nbeschrijving, criteria)
deactivate planning
handler -> owes : bewaar(owe)
activate owes
deactivate owes
handler -> regel : alle = controleer(owe)
activate regel
deactivate regel
loop voor elke overtreding in alle
  handler -> overtreding : betreft(les)
  activate overtreding
  deactivate overtreding
end
handler --> ontwikkelaar : overtredingen
deactivate handler
note over rubric, les
  4A: controleerWeek, zoekCriteria en create
  gooien een OngeldigeInvoerException bij
  ongeldige gegevens [BR11].
  Dan bewaart de handler niets.
end note
note over regel, overtreding
  overtredingen: de overtredingen
  die les betreffen.
  Niet leeg betekent 6A: les opgeslagen,
  maar BR2 overtreden.
end note
@enduml
