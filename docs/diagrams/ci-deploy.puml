@startuml ci-deploy
' Activity diagram of the workflow Deploy. Explanation: docs/deployment.md
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Helvetica

start
:Push to main or develop
that changes the application or infra;
fork
  :Build the image api
  and run its unit tests;
  :Push it to ghcr.io;
fork again
  :Build the image documentserver
  and run its unit tests;
  :Push it to ghcr.io;
fork again
  :Build the image web;
  :Push it to ghcr.io;
end fork
if (All three builds passed?) then (yes)
  :Send a signed message to doco-cd;
  :doco-cd deploys the new version;
  stop
else (no)
  :The server keeps the old version;
  stop
endif
@enduml
