{
	admin off
}

# On a laptop SITE_ADDRESS is `:8080`, so Caddy serves plain HTTP.
# On the server it is the domain name, so Caddy gets a certificate itself.
{$SITE_ADDRESS} {
	root * /srv
	file_server
}

# Extra sites that only the server has. The directory is empty on a laptop.
import /etc/caddy/conf.d/*.caddy
